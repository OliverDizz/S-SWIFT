# scripts/config.env
#
# Shared configuration for the Swift dataset download and preparation pipeline.
#
# Shell scripts source this file after they set REPO_ROOT:
#
#     SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
#     REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
#     source "${SCRIPT_DIR}/config.env"
#
# Python scripts parse this file through scripts/config.py, which computes
# REPO_ROOT from its own location and expands ${KEY} references the same way.
#
# Values use ${REPO_ROOT} and ${CONDA_ENVS_DIR} so the same file works on any
# checkout. CONDA_ENVS_DIR is the directory that holds the conda environments
# (sam3, mv_env). It is auto-detected and does not need to be set:
#   1. $CONDA_ENVS_DIR (explicit override)
#   2. ~/conda_envs, ~/.conda/envs, <conda base>/envs (first that holds the envs)
# Set it only when your conda environments live somewhere unusual.

# ---- Paths ----------------------------------------------------------------
DATA_DIR=${REPO_ROOT}/data
RAW_DIR=${REPO_ROOT}/data/raw
MANIFESTS_DIR=${REPO_ROOT}/data/manifests
# Version-controlled metadata shipped with the repo (authoritative selection).
MANIFESTS_SRC=${REPO_ROOT}/scripts/manifests
KINETICS_DIR=${REPO_ROOT}/data/kinetics
DERF_DIR=${REPO_ROOT}/data/derf
UVG_DIR=${REPO_ROOT}/data/uvg

# ---- Environment binaries --------------------------------------------------
# Python for the standard-library pipeline helpers (download driver, config.py).
PYTHON=/usr/bin/python3
# sam3 conda env: PyTorch, cv2, scikit-image, PyYAML (SAM3 masks and edges).
SAM3_PYTHON=${CONDA_ENVS_DIR}/sam3/bin/python
# mv_env conda env: FFmpeg 2.8.6 + OpenCV 2.4.11 + gcc toolchain for MV tools.
MV_ENV_DIR=${CONDA_ENVS_DIR}/mv_env
MV_ENV_FFMPEG=${MV_ENV_DIR}/bin/ffmpeg
MV_ENV_GXX=${MV_ENV_DIR}/bin/x86_64-conda-linux-gnu-g++
MV_ENV_GCC=${MV_ENV_DIR}/bin/x86_64-conda-linux-gnu-gcc
MV_ENV_PKG_CONFIG=${MV_ENV_DIR}/bin/pkg-config
MV_ENV_PKG_CONFIG_PATH=${MV_ENV_DIR}/lib/pkgconfig
# system ffmpeg 6.1.1 + ffprobe for reliable y4m/raw-YUV decoding and probing.
SYSTEM_FFMPEG=/usr/bin/ffmpeg
SYSTEM_FFPROBE=/usr/bin/ffprobe
# Built MV tool binaries. 02_motion_vectors.sh builds them when missing.
# flows/MV_extract/ffmpeg-2.7.2 is a modified ffmpeg (H264 motion-vector export
# in libavcodec/mpegvideo.c). The standard mv_env ffmpeg 2.8.6 already exports
# H264 motion vectors, so extract_mvs is built from the bundled example source
# against the mv_env 2.8.6 headers instead of building the whole 2.7.2 library.
MOTIONVECTOR_BIN=${REPO_ROOT}/flows/MV_extract/MV-code-release/MotionVector
EXTRACT_MVS_BIN=${REPO_ROOT}/flows/MV_extract/extract_mvs
EXTRACT_MVS_SRC=${REPO_ROOT}/flows/MV_extract/ffmpeg-2.7.2/doc/examples/extract_mvs.c
DRAW_FLOW_SRC=${REPO_ROOT}/flows/MV_extract/MV-code-release/draw_flow.cpp
GET_MV_SH=${REPO_ROOT}/flows/get_mv.sh
# SAM3 source tree. The editable install can be stale; prepend this to sys.path.
SAM3_SRC=${REPO_ROOT}/external/sam3

# ---- Kinetics scope --------------------------------------------------------
N_KINETICS=10000
N_TRAIN=8000
N_TEST=2000
FRAMES_PER_CLIP=100
KINETICS_W=352
KINETICS_H=288
SPLIT_SEED=0
# CVDF S3 mirror of the official Kinetics-400 videos. It serves tar.gz archives
# (~1.5 GB, ~1000 clips each), so no YouTube access is needed. Annotations give
# the labels; archive clips are joined by (youtube_id, time_start).
K400_TRAIN_CSV=https://s3.amazonaws.com/kinetics/400/annotations/train.csv
K400_VAL_CSV=https://s3.amazonaws.com/kinetics/400/annotations/val.csv
K400_TRAIN_PATH_LIST=https://s3.amazonaws.com/kinetics/400/train/k400_train_path.txt
K400_VAL_PATH_LIST=https://s3.amazonaws.com/kinetics/400/val/k400_val_path.txt
# Number of archives to download per split. Raise these if the sample is short.
K400_TRAIN_PARTS=10
K400_VAL_PARTS=3
KINETICS_MANIFEST=${MANIFESTS_SRC}/kinetics_split.csv

# ---- Test datasets ---------------------------------------------------------
DERF_BASE=https://media.xiph.org/video/derf/y4m
DERF_SEQS="blue_sky flower foreman four_people soccer stefan tennis vidyo3 waterfall silent"
DERF_MANIFEST=${MANIFESTS_SRC}/derf_sequences.csv
UVG_BASE=https://ultravideo.fi/video
UVG_SEQS="Beauty Bosphorus HoneyBee Jockey ReadySetGo ShakeNDry YachtRide"
UVG_MANIFEST=${MANIFESTS_SRC}/uvg_sequences.csv

# ---- Canny -----------------------------------------------------------------
CANNY_LOW=50
CANNY_HIGH=150

# ---- Prompts ---------------------------------------------------------------
PROMPTS_SRC=${REPO_ROOT}/scripts/prompts.yaml
PROMPTS_YAML=${REPO_ROOT}/scripts/prompts.yaml
# Optional Kinetics action-label -> noun-concept override map. Kinetics labels
# are actions, but SAM3 segments noun concepts, so the default prompt is
# "person" (the actor). Add per-class noun prompts here to refine the ROI.
KINETICS_PROMPTS_YAML=${REPO_ROOT}/scripts/kinetics_prompts.yaml

# ---- Parallelism -----------------------------------------------------------
PARALLELISM=8

# ---- GPU (SAM3 masks) ------------------------------------------------------
SAM3_GPU=0
